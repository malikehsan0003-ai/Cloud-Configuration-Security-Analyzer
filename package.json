{
  "name": "cloud-config-security-analyzer",
  "version": "1.0.0",
  "description": "A working prototype that helps engineers review cloud configuration data, identify risky settings, prioritize findings, and produce remediation reports.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "jest --verbose --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "analyze": "node scripts/analyze.js",
    "health-check": "node scripts/health-check.js",
    "lint": "eslint src/ tests/ scripts/",
    "audit": "npm audit --production"
  },
  "dependencies": {
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.0",
    "uuid": "^10.0.0",
    "json2csv": "^6.0.0-alpha.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "eslint": "^8.57.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
